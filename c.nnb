                "import { inspect } from \"node:util\";\n\nlet simpleFunction = (a: number) => {\n    let x = 12;\n    return x + a * a;\n}\n\n// Use inspect to print the function\nconsole.log(inspect(simpleFunction, { showHidden: false, depth: null, color: true }));\n"
